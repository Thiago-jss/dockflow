<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · DockFlow</title>
    <link rel="stylesheet" href="~/dockflow.css" asp-append-version="true" />
</head>
<body>
<header class="top"><div class="wrap top-inner"><a class="brand" href="/"><span aria-hidden="true">▦</span> DockFlow</a>
@if (User.Identity?.IsAuthenticated == true)
{
    <form method="post" asp-controller="Dashboard" asp-action="SignOutOfApp"><button class="quiet" type="submit">Sair do painel</button></form>
}
</div></header>
<main class="wrap" id="main">@RenderBody()</main>
<footer class="wrap">DockFlow <span> / </span> Operações de pátio</footer>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
