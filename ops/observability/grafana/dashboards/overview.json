{
  "title": "DockFlow | Laboratório operacional",
  "uid": "dockflow-ops",
  "schemaVersion": 41,
  "refresh": "15s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requisições por segundo",
      "datasource": {
        "type": "prometheus",
        "uid": "dockflow-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "h": 8,
        "w": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_count[2m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "dockflow-prom"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Leituras do cache de indicadores",
      "datasource": {
        "type": "prometheus",
        "uid": "dockflow-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "h": 8,
        "w": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome)(dockflow_analytics_cache_reads_total)",
          "datasource": {
            "type": "prometheus",
            "uid": "dockflow-prom"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p95 das requisições (s)",
      "datasource": {
        "type": "prometheus",
        "uid": "dockflow-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "h": 8,
        "w": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket[2m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "dockflow-prom"
          }
        }
      ]
    }
  ]
}
